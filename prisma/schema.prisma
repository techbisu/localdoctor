generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  DOCTOR
  PHARMACY
  LAB
  CITIZEN
}

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  password      String
  name          String?
  role          UserRole      @default(CITIZEN)
  status        AccountStatus @default(PENDING)
  emailVerified DateTime?
  image         String?
  phone         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  doctor       Doctor?
  pharmacy     MedicineShop?
  lab          MedicalLab?
  appointments Appointment[]   @relation("CitizenAppointments")
  auditLogs    AuditLog[]
  reviews      Review[]

  @@map("users")
}

model Specialization {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0) @map("sort_order")
  status      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  doctors      DoctorSpecialization[]
  problems     MedicalProblemSpecialization[]

  @@map("specializations")
}

model MedicalProblem {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  status      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  specializations MedicalProblemSpecialization[]
  doctors         DoctorMedicalProblem[]

  @@map("medical_problems")
}

model MedicalProblemSpecialization {
  problemId       String @map("problem_id")
  specializationId String @map("specialization_id")

  problem        MedicalProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  specialization Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([problemId, specializationId])
  @@map("medical_problem_specializations")
}

model Doctor {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  slug            String   @unique
  title           String?
  name            String
  email           String?
  phone           String?
  gender          String?
  about           String?  @db.Text
  qualifications  String?
  experienceYears Int?     @map("experience_years")
  languages       String[]
  consultationFee Int?     @map("consultation_fee")
  profileImage    String?  @map("profile_image")
  rating          Float?   @default(0)
  reviewCount     Int      @default(0) @map("review_count")
  viewCount       Int      @default(0) @map("view_count")
  status          VerificationStatus @default(PENDING)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  specializations  DoctorSpecialization[]
  medicalProblems  DoctorMedicalProblem[]
  chambers         Chamber[]
  reviews          Review[]
  services         DoctorService[]

  @@index([slug])
  @@index([status])
  @@index([name])
  @@map("doctors")
}

model DoctorSpecialization {
  doctorId         String @map("doctor_id")
  specializationId String @map("specialization_id")

  doctor         Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialization Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([doctorId, specializationId])
  @@map("doctor_specializations")
}

model DoctorMedicalProblem {
  doctorId   String @map("doctor_id")
  problemId  String @map("problem_id")

  doctor  Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  problem MedicalProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([doctorId, problemId])
  @@map("doctor_medical_problems")
}

model HealthcareService {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  category    String
  description String?
  status      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  doctorServices DoctorService[]
  labServices    LabService[]
  pharmacyServices PharmacyService[]

  @@map("healthcare_services")
}

model DoctorService {
  doctorId  String @map("doctor_id")
  serviceId String @map("service_id")

  doctor  Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  service HealthcareService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([doctorId, serviceId])
  @@map("doctor_services")
}

model Chamber {
  id                String   @id @default(cuid())
  doctorId          String   @map("doctor_id")
  name              String
  address           String
  city              String
  district          String?
  state             String?
  pincode           String?
  latitude          Float?
  longitude         Float?
  phone             String?
  appointmentEnabled Boolean @default(false) @map("appointment_enabled")
  slotDuration      Int      @default(15) @map("slot_duration")
  status            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  schedules    ChamberSchedule[]
  holidays     ChamberHoliday[]
  appointments Appointment[]

  @@index([doctorId])
  @@index([latitude, longitude])
  @@index([city])
  @@map("chambers")
}

model ChamberSchedule {
  id        String    @id @default(cuid())
  chamberId String    @map("chamber_id")
  day       DayOfWeek
  startTime String    @map("start_time")
  endTime   String    @map("end_time")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  chamber Chamber @relation(fields: [chamberId], references: [id], onDelete: Cascade)

  @@map("chamber_schedules")
}

model ChamberHoliday {
  id        String   @id @default(cuid())
  chamberId String   @map("chamber_id")
  date      DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  chamber Chamber @relation(fields: [chamberId], references: [id], onDelete: Cascade)

  @@map("chamber_holidays")
}

model MedicineShop {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  slug            String   @unique
  name            String
  description     String?
  address         String
  city            String
  district        String?
  state           String?
  pincode         String?
  latitude        Float?
  longitude       Float?
  phone           String?
  email           String?
  website         String?
  openingHours    String?  @map("opening_hours")
  is24Hour        Boolean  @default(false) @map("is_24_hour")
  homeDelivery    Boolean  @default(false) @map("home_delivery")
  licenseNumber   String?  @map("license_number")
  profileImage    String?  @map("profile_image")
  status          VerificationStatus @default(PENDING)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  services PharmacyService[]
  reviews  Review[]

  @@index([slug])
  @@index([status])
  @@index([latitude, longitude])
  @@map("medicine_shops")
}

model PharmacyService {
  pharmacyId String @map("pharmacy_id")
  serviceId  String @map("service_id")

  pharmacy MedicineShop      @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  service  HealthcareService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([pharmacyId, serviceId])
  @@map("pharmacy_services")
}

model MedicalLab {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  slug              String   @unique
  name              String
  description       String?
  address           String
  city              String
  district          String?
  state             String?
  pincode           String?
  latitude          Float?
  longitude         Float?
  phone             String?
  email             String?
  website           String?
  openingHours      String?  @map("opening_hours")
  homeSampleCollection Boolean @default(false) @map("home_sample_collection")
  accreditation     String?
  licenseNumber     String?  @map("license_number")
  profileImage        String?  @map("profile_image")
  status              VerificationStatus @default(PENDING)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  services LabService[]
  reviews  Review[]

  @@index([slug])
  @@index([status])
  @@index([latitude, longitude])
  @@map("medical_labs")
}

model LabService {
  labId     String @map("lab_id")
  serviceId String @map("service_id")

  lab     MedicalLab        @relation(fields: [labId], references: [id], onDelete: Cascade)
  service HealthcareService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([labId, serviceId])
  @@map("lab_services")
}

model Appointment {
  id            String            @id @default(cuid())
  reference     String            @unique
  chamberId     String            @map("chamber_id")
  citizenName   String            @map("citizen_name")
  citizenPhone  String            @map("citizen_phone")
  citizenEmail  String?           @map("citizen_email")
  userId        String?           @map("user_id")
  appointmentDate DateTime        @db.Date @map("appointment_date")
  startTime     String            @map("start_time")
  endTime       String            @map("end_time")
  status        AppointmentStatus @default(PENDING)
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  chamber  Chamber  @relation(fields: [chamberId], references: [id], onDelete: Cascade)
  user     User?    @relation("CitizenAppointments", fields: [userId], references: [id], onDelete: SetNull)
  history  AppointmentStatusHistory[]

  @@index([chamberId])
  @@index([appointmentDate])
  @@index([status])
  @@index([reference])
  @@map("appointments")
}

model AppointmentStatusHistory {
  id            String            @id @default(cuid())
  appointmentId String            @map("appointment_id")
  status        AppointmentStatus
  notes         String?
  createdById   String?           @map("created_by_id")
  createdAt     DateTime          @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("appointment_status_histories")
}

model Review {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  doctorId  String?  @map("doctor_id")
  pharmacyId String? @map("pharmacy_id")
  labId     String?  @map("lab_id")
  rating    Int
  comment   String?
  isVerified Boolean @default(false) @map("is_verified")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor   Doctor?       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  pharmacy MedicineShop? @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  lab      MedicalLab?   @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entityType String @map("entity_type")
  entityId  String?  @map("entity_id")
  metadata  Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model VerificationDocument {
  id           String   @id @default(cuid())
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  documentType String   @map("document_type")
  documentUrl  String   @map("document_url")
  status       VerificationStatus @default(PENDING)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([entityType, entityId])
  @@map("verification_documents")
}
